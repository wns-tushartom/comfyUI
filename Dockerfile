FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ARG COMFYUI_REF=12d5279438bfefc058a269eae805ceab6047777f
ARG COMFYUI_VERSION=0.34.0
ARG LTX_REF=d151147788a9284cca791edc6ce898007e727fe6
ARG LTX_VERSION=v1.2.0
ARG TORCH_VERSION=2.9.1
ARG TORCHVISION_VERSION=0.24.1
ARG TORCHAUDIO_VERSION=2.9.1
ARG PIP_VERSION=26.0.1
ARG SETUPTOOLS_VERSION=82.0.0
ARG WHEEL_VERSION=0.46.3

LABEL org.opencontainers.image.comfyui.version="${COMFYUI_VERSION}" \
      org.opencontainers.image.comfyui.revision="${COMFYUI_REF}" \
      org.opencontainers.image.ltx.version="${LTX_VERSION}" \
      org.opencontainers.image.ltx.revision="${LTX_REF}"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH=/opt/venv/bin:${PATH} \
    PYTHONPATH=/opt/wns:/opt/ComfyUI \
    PORT=8188 \
    WNS_DATA_ROOT=/data \
    WNS_LTX_AUTO_DOWNLOAD=1 \
    WNS_FORCE_CPU=0 \
    HF_HOME=/data/huggingface

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates curl ffmpeg git gzip libgl1 libglib2.0-0 libgomp1 \
      python3.12 python3.12-venv tar \
    && command -v ffmpeg \
    && command -v ffprobe \
    && rm -rf /var/lib/apt/lists/*

RUN python3.12 -m venv /opt/venv \
    && python -m pip install --upgrade \
      "pip==${PIP_VERSION}" "setuptools==${SETUPTOOLS_VERSION}" "wheel==${WHEEL_VERSION}"

WORKDIR /opt
RUN git init /opt/ComfyUI \
    && git -C /opt/ComfyUI remote add origin https://github.com/Comfy-Org/ComfyUI.git \
    && git -C /opt/ComfyUI fetch --depth 1 origin "${COMFYUI_REF}" \
    && git -C /opt/ComfyUI checkout --detach FETCH_HEAD \
    && test "$(git -C /opt/ComfyUI rev-parse HEAD)" = "${COMFYUI_REF}"

RUN git init /opt/LTX-Video \
    && git -C /opt/LTX-Video remote add origin https://github.com/Lightricks/LTX-2.git \
    && git -C /opt/LTX-Video fetch --depth 1 origin \
      "refs/tags/${LTX_VERSION}:refs/tags/${LTX_VERSION}" \
    && git -C /opt/LTX-Video checkout --detach "refs/tags/${LTX_VERSION}" \
    && test "$(git -C /opt/LTX-Video rev-parse HEAD)" = "${LTX_REF}"

RUN python -m pip install --index-url https://download.pytorch.org/whl/cu128 \
      "torch==${TORCH_VERSION}" \
      "torchvision==${TORCHVISION_VERSION}" \
      "torchaudio==${TORCHAUDIO_VERSION}"

# The generator replaces this marker with one canonical base64-encoded USTAR.
# WNS_CANONICAL_TAR {"encoding":"base64","format":"ustar+gzip","sha256":"f84aedeedec2b4c4688770a44f947345246d19a3d09f30df8b2943dfe5f2168a","size":163299}
RUN printf '%s' '' > /wns-payload.b64
RUN printf '%s' '' >> /wns-payload.b64
RUN printf '%s' '' >> /wns-payload.b64
RUN printf '%s' '' >> /wns-payload.b64
RUN base64 -d /wns-payload.b64 | gzip -dc | tar --extract --file - --directory / --no-same-owner --no-same-permissions \
    && rm -f /wns-payload.b64

RUN python -m pip install --requirement /opt/wns/ltx-requirements.lock \
    && python -m pip install --no-deps /opt/LTX-Video/packages/ltx-core \
    && python -m pip install --no-deps /opt/LTX-Video/packages/ltx-pipelines \
    && chmod 0755 /usr/local/bin/start-comfyui /opt/wns/standalone_manifest.py \
    && mkdir -p /data/input /data/output /data/temp /data/models \
      /data/user/default/workflows /data/huggingface \
    && chmod 0700 /data /data/input /data/output /data/temp /data/models \
      /data/user /data/user/default /data/user/default/workflows /data/huggingface \
    && python /opt/wns/standalone_manifest.py \
      --verify --manifest /opt/wns/standalone-manifest.json --root / \
    && python -c "from comfyui_version import __version__; assert __version__ == '${COMFYUI_VERSION}'" \
    && python -c "import ltx_core,ltx_pipelines; assert ltx_core and ltx_pipelines" \
    && python -c "import sys,wns_ltx_runner; assert 'torch' not in sys.modules" \
    && python -c "import wns_ltx_runner.pipelines" \
    && python -c "from custom_nodes.wns_replicate_video import ltx_protocol,ltx_resources; assert ltx_protocol and ltx_resources" \
    && python -m wns_ltx_runner --self-check

WORKDIR /opt/ComfyUI
VOLUME ["/data"]
EXPOSE 8188
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=5 \
  CMD curl -fsS "http://127.0.0.1:${PORT:-8188}/system_stats" >/dev/null || exit 1
CMD ["/usr/local/bin/start-comfyui"]

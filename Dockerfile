    && mkdir -p /data \
    && chmod 0700 /data

EXPOSE 8188
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
  CMD curl -fsS "http://127.0.0.1:${PORT:-8188}/system_stats" >/dev/null || exit 1

CMD ["/usr/local/bin/start-comfyui"]
